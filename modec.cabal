cabal-version:      3.0
name:               modec
version:            0.1.0.0
synopsis:           Software audio modem (Bell 103, V.21, V.22, V.22bis) in Haskell
license:            NONE
build-type:         Simple
extra-doc-files:    SURVEY.md

common warnings
    ghc-options: -Wall -O2

library
    import:           warnings
    exposed-modules:  Modec.DSP
                      Modec.Stream
                      Modec.Sample
                      Modec.Voice
                      Modec.Wav
                      Modec.G711
                      Modec.FSK
                      Modec.Standards
                      Modec.Link
                      Modec.Channel
                      Modec.Metrics
                      Modec.Detect
                      Modec.Handshake
                      Modec.Handshake.Cues
                      Modec.Handshake.Modes
                      Modec.Modem
                      Modec.Modem.Tx
                      Modec.Replay
                      Modec.Fixture
                      Modec.Loopback
                      Modec.Session
                      Modec.Telnet
                      Modec.Async
                      Modec.Baudot
                      Modec.V22
                      Modec.Scrambler
                      Modec.QAM
                      Modec.Echo
                      Modec.V32
                      Modec.V32Pump
                      Modec.V32Start
                      Modec.Hdlc
                      Modec.MnpFrame
                      Modec.Mnp
                      Modec.V8
                      Modec.Hayes
                      Modec.Dtmf
                      Modec.Progress
                      Modec.Json
                      Modec.Baresip
                      Modec.Pipewire
    -- No `process`, no `network`, no `unix`.  The test suite links
    -- against this library, and what it cannot link it cannot do: a
    -- test can no more place a call or open a sound card than it can
    -- fork.  The half of the PipeWire interface that runs pw-dump lives
    -- in the executable, as app/PipewireIO.hs.
    build-depends:    base ^>=4.18,
                      bytestring,
                      vector
    hs-source-dirs:   src
    default-language: Haskell2010

executable modec
    import:           warnings
    main-is:          Main.hs
    other-modules:    Modem
                      CallLog
                      Dial
                      Serial
                      FakeDongle
                      PipewireIO
                      Paths_modec
    autogen-modules:  Paths_modec
    ghc-options:      -threaded -rtsopts
    build-depends:    base ^>=4.18,
                      modec,
                      bytestring,
                      vector,
                      optparse-applicative,
                      network,
                      process,
                      unix,
                      directory,
                      filepath,
                      time
    hs-source-dirs:   app
    default-language: Haskell2010

executable modec-bench
    import:           warnings
    main-is:          Bench.hs
    build-depends:    base ^>=4.18,
                      modec,
                      vector,
                      optparse-applicative
    hs-source-dirs:   app
    default-language: Haskell2010

test-suite modec-test
    import:           warnings
    default-language: Haskell2010
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    other-modules:    Corpus
                      Harness
                      Suite.Channel
                      Suite.Dsp
                      Suite.Fsk
                      Suite.Link
                      Suite.Mnp
                      Suite.Sample
                      Suite.Voice
                      Suite.Session
                      Suite.Tones
                      Suite.Tools
                      Suite.V22
                      Suite.V32
    -- The suite is CPU bound -- it simulates about twenty-five minutes of
    -- telephone audio -- and tasty schedules cases concurrently, which
    -- does nothing at all on a single capability.
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"
    build-depends:    base ^>=4.18,
                      modec,
                      bytestring,
                      vector,
                      directory,
                      filepath,
                      tasty,
                      tasty-hunit,
                      tasty-quickcheck,
                      QuickCheck
