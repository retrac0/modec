# One line per SIP account.  Replace user, password and domain with your
# provider's values.  answermode=manual leaves answering to modec (ATA).
# audio_codecs restricts the offer to G.711.
<sip:user@sip.provider.example>;auth_pass=password;audio_codecs=PCMU/8000/1,PCMA/8000/1;answermode=manual;regint=300;pubint=0
