dist-newstyle/
*.hi
*.o
pw
*.wav.tmp

# Call recordings: kept on disk, too bulky for git.  The handful
# already tracked stay tracked; sweeps add tens of megabytes a run.
# The per-call logs and the index go the same way: they describe
# recordings that are not in the repository either.
recordings/*.wav
recordings/*.log
recordings/third-party/**/*.wav
recordings/third-party/*.wav

# The bench sweep (scripts/bench/sweep.py) writes a call, two WAVs and
# a log per mode here; same reasoning as the recordings above it.
recordings/bench/
